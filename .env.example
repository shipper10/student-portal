# Copy this file to .env.local for local development.
# On Vercel, set the same two variables under Project Settings > Environment Variables.
# Never expose these with a NEXT_PUBLIC_ prefix — they must stay server-side only.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Clerk (sign-in / sign-up) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile
# Comma-separated Clerk user IDs (user_xxx) of administrators. Server-side only.
ADMIN_CLERK_USER_IDS=
